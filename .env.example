# Copy this file to .env and edit. .env is gitignored, so your local settings
# stay on your machine. Every variable below is optional: with no .env at all
# the app runs from the repo exactly as it does today.
#
# A variable already set in the real environment wins over this file, so a
# server or a CI job can configure itself without one.
#
# To see what the app will actually use:
#
#     python src/config.py


# ---------------------------------------------------------------------------
# How the app is served
# ---------------------------------------------------------------------------

# The debug console executes Python on the host machine. Keep it true on your
# own laptop for hot reloading; set it false on anything anyone else can reach.
DASH_DEBUG=true

# 127.0.0.1 is reachable only from this machine. Use 0.0.0.0 on a server, or
# to let colleagues on the office network open your laptop's copy.
DASH_HOST=127.0.0.1
DASH_PORT=8050


# ---------------------------------------------------------------------------
# Development aid: pretend we are embedded in 4insight
# ---------------------------------------------------------------------------
# In production this app sits in an iframe below 4insight's own header, which
# takes 84px, with 24px of dead space under the frame. Set the first of these
# to 84 while working on layout and the app reserves the same space locally,
# so your screen shows what a user actually gets.
#
# Leave it at 0 (or delete the line) for anything you deploy - on the server
# the real header is already there and this would draw a second one.

# MOCK_PLATFORM_CHROME=84
# MOCK_PLATFORM_GAP=24
