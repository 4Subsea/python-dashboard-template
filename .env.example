# Copy this file to .env and edit. .env is gitignored, so your local settings
# stay on your machine.

# A variable already set in the real environment wins over this file.


# ---------------------------------------------------------------------------
# How the app is served
# ---------------------------------------------------------------------------

# The debug console executes Python on the host machine. Keep it true on your
# own laptop for hot reloading; set it false on anything anyone else can reach.
DASH_DEBUG=true


# ---------------------------------------------------------------------------
# Development aid: pretend we are embedded in 4insight
# ---------------------------------------------------------------------------
# In production this app sits in an iframe below 4insight's own header, which
# takes 82px, with 20px of dead space under the frame. Set the first of these
# to 82 while working on layout and the app reserves the same space locally,
# so your screen shows what a user actually gets.
#
# Leave it at 0 (or delete the line) for anything you deploy - on the server
# the real header is already there and this would draw a second one.

MOCK_PLATFORM_HEADER=82
MOCK_PLATFORM_SPACER=20
